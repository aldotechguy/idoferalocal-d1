{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "tsx --test scripts/relational-money-roundtrip.test.ts scripts/mutation-killing.test.ts scripts/money-ledger.test.ts scripts/regression/money-golden.test.ts"
  },
  "concurrency": 8,
  "timeoutMS": 60000,
  "timeoutFactor": 3,
  "mutate": [
    "src/server/relationalMapper.ts:11-27",
    "src/server/relationalMapper.ts:49-64",
    "src/server/relationalMapper.ts:118-171",
    "src/server/relationalMapper.ts:253-369"
  ],
  "reporters": ["json", "clear-text"],
  "jsonReporter": { "fileName": "reports/mutation/relationalMapper.json" },
  "thresholds": { "high": 90, "low": 70, "break": 80 },
  "cleanTempDir": "always",
  "coverageAnalysis": "off",
  "allowConsoleColors": false,
  "tempDirName": ".stryker-tmp-rm"
}