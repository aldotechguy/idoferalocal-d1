      "description": "Open POS cash register for sales",
      "url": "/",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Inventory & Stock Catalog",
      "short_name": "Stock",
      "description": "View and manage packaging inventory",
      "url": "/?tab=inventory",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "System Settings & Cloud Sync",
      "short_name": "Settings",
      "description": "Access system configuration & sync",
      "url": "/?tab=settings",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
