{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "tsx --test scripts/money-ledger.test.ts"
  },
  "concurrency": 8,
  "timeoutMS": 60000,
  "timeoutFactor": 3,
  "mutate": ["src/context/moneyLedger.ts"],
  "reporters": ["json", "clear-text"],
  "jsonReporter": { "fileName": "reports/mutation/moneyLedger.json" },
  "thresholds": { "high": 90, "low": 70, "break": 80 },
  "cleanTempDir": "always",
  "coverageAnalysis": "off",
  "allowConsoleColors": false,
  "tempDirName": ".stryker-tmp-ml"
}