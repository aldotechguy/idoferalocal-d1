# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_DRIVE_API_KEY: Optional default Google Drive API Key for backup/restore
VITE_GOOGLE_DRIVE_API_KEY=""

# Cloudflare D1 Database Integration
CLOUDFLARE_D1_DATABASE_ID="3e95a550-a091-490b-819d-f0acb7ea8dd8"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Cloudflare Access staff gate (docs/staff-access.md).
# The Node twin mirrors the Worker's variable names 1:1 for `npm run dev`.
# Nothing is required to run locally: with CF_ACCESS_SSO unset (or the team
# domain / AUD empty) the password login behaves exactly as before.
#   CF_ACCESS_SSO             "true" enables the SSO session bootstrap in
#                             GET /api/auth/session; anything else keeps
#                             password login only.
#   CF_ACCESS_TEAM_DOMAIN     https://<team-name>.cloudflareaccess.com
#   CF_ACCESS_AUD             Comma-separated Audience tags — one per Access
#                             application covering the staff paths (each mints
#                             its own; include the /api/auth/session app's tag).
#   CF_ACCESS_SUPER_ADMIN_GROUP  Optional. When set, the verified Access JWT
#                             must also carry this group before a super-admin
#                             session exists. Leave empty to disable the group
#                             requirement (fail-open on that one leg).
#   CF_ACCESS_STEP_UP_SECONDS Optional step-up lifetime, default 600.
CF_ACCESS_SSO="false"
CF_ACCESS_TEAM_DOMAIN=""
CF_ACCESS_AUD=""
CF_ACCESS_SUPER_ADMIN_GROUP=""
CF_ACCESS_STEP_UP_SECONDS="600"
