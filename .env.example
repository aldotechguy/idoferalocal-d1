# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_DRIVE_API_KEY: Optional default Google Drive API Key for backup/restore
VITE_GOOGLE_DRIVE_API_KEY=""

# Cloudflare D1 Database Integration
CLOUDFLARE_D1_DATABASE_ID="3e95a550-a091-490b-819d-f0acb7ea8dd8"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Cloudflare Access staff gate (docs/staff-access.md).
# The Node twin mirrors the Worker's variable names 1:1 for `npm run dev`.
# Nothing is required to run locally: with CF_ACCESS_SSO unset (or the team
# domain / AUD empty) the password login behaves exactly as before.
#   CF_ACCESS_SSO             "true" enables the SSO session bootstrap in
#                             GET /api/auth/session; anything else keeps
#                             password login only.
#   CF_ACCESS_TEAM_DOMAIN     https://<team-name>.cloudflareaccess.com
#   CF_ACCESS_AUD             Comma-separated Audience tags — one per Access
#                             application covering the staff paths (each mints
#                             its own; include the /api/auth/session app's tag).
#   CF_ACCESS_SUPER_ADMIN_GROUP  Optional. When set, the verified Access JWT
#                             must also carry this group before a super-admin
#                             session exists. Leave empty to disable the group
#                             requirement (fail-open on that one leg).
#   CF_ACCESS_STEP_UP_SECONDS Optional step-up lifetime, default 600.
CF_ACCESS_SSO="false"
CF_ACCESS_TEAM_DOMAIN=""
CF_ACCESS_AUD=""
CF_ACCESS_SUPER_ADMIN_GROUP=""
CF_ACCESS_STEP_UP_SECONDS="600"
#   Optional. Staff app-session idle window in seconds (default 1800 = 30 min).
#   A session that has not been seen within this window stops authorizing
#   private APIs, and the client warns then auto-locks on the same boundary.
CF_SESSION_IDLE_SECONDS=""

# ---------------------------------------------------------------------------
# Read-only production reconciliation monitor (docs/test-setup-runbook.md §9).
#   npm run verify:prod-reconciliation [-- --dry-run]
# Runs SELECT-only queries against the LIVE production D1 (name `idofera`) and
# prints a pass/fail drift table. It NEVER writes to D1: supply a Cloudflare
# token scoped to "D1 → Read" only, and readSelect() refuses non-SELECT.
# On drift it POSTs a signed alert to MALL_WEBHOOK_URL (the same receiver the
# Worker's outbox drain uses) and exits non-zero; --dry-run suppresses that.
# SCHEDULING: .github/workflows/prod-reconciliation.yml (every 30 min) or a
# Cloudflare cron on `--env mall`.
#   RECON_CF_API_TOKEN        read-only "D1 → Read" token (falls back to CF_API_TOKEN)
#   RECON_CF_ACCOUNT_ID       falls back to CLOUDFLARE_ACCOUNT_ID
#   RECON_D1_DATABASE_ID      defaults to the wrangler.toml [env.mall] id; the
#                             preview database is hard-denied as a read target
#   RECON_DRAIN_FRESH_MIN     drain ('maintenance') freshness window, default 30
#   RECON_SWEEP_FRESH_MIN     sweep ('sweep') freshness window, default 120
#   RECON_STALE_ORDER_HOURS   non-terminal mall order SLA, default 48
#   RECON_MONEY_TOLERANCE_KOBO  money identity tolerance (kobo), default 0
#   MALL_WEBHOOK_URL / MALL_WEBHOOK_SECRET   failure-alert receiver + signing key
RECON_CF_API_TOKEN=""
RECON_D1_DATABASE_ID=""
