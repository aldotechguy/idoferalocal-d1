{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "tsx --test scripts/money-ledger.test.ts scripts/mutation-killing.test.ts scripts/money-invariants.test.ts scripts/relational-money-roundtrip.test.ts scripts/mall-order-money.test.ts scripts/mall-safety.test.ts scripts/money-flow.integration.test.ts scripts/regression/mall-money-writes.test.ts scripts/regression/money-golden.test.ts"
  },
  "concurrency": 8,
  "timeoutMS": 150000,
  "timeoutFactor": 3,
  "mutate": [
    "src/server/mallApi.ts",
    "src/server/mallOrderAdminApi.ts",
    "src/server/mallOperations.ts",
    "src/server/relationalWrites.ts",
    "src/server/relationalMapper.ts:11-27",
    "src/server/relationalMapper.ts:49-64",
    "src/server/relationalMapper.ts:118-171",
    "src/server/relationalMapper.ts:253-369",
    "src/context/moneyLedger.ts"
  ],
  "ignorePatterns": [
    "node_modules", "dist", "coverage", ".stryker-tmp", "playwright-report", "test-results",
    "public", "e2e", "backups", "docs", "drizzle"
  ],
  "reporters": ["progress", "html", "json"],
  "thresholds": { "high": 90, "low": 70, "break": 80 },
  "cleanTempDir": "always",
  "coverageAnalysis": "off",
  "allowConsoleColors": false
}
