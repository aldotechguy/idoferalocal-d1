{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "audit:frontend": "node scripts/audit-frontend.mjs",
    "test:frontend": "tsx --test scripts/frontend-smoke.test.ts",
    "test:mall-backend": "tsx --test scripts/mall-backend.test.ts scripts/mall-safety.test.ts",
    "verify:frontend": "npm run lint && npm run audit:frontend && npm run test:frontend",
    "verify:mall": "npm run lint && npm run test:mall-backend",
    "verify:mall-preview": "tsx scripts/mall-preview-check.ts",
    "demo:mall-cascade": "tsx scripts/mall-cascade-demo.ts",
    "mail:test": "tsx scripts/send-mall-test-emails.ts",
    "ddl:gen": "tsx scripts/etl/gen-ddl.ts",
    "etl:dump": "tsx scripts/etl/dump.ts",
    "etl:run": "tsx scripts/etl/run.ts",
    "verify:relational": "tsx scripts/verify-relational.ts",
    "verify:writes": "tsx scripts/verify-relational-writes.ts",
    "verify": "tsx scripts/verify-relational.ts && tsx scripts/verify-relational-writes.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
