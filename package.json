{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && tsx scripts/generate-precache-manifest.ts && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "audit:frontend": "node scripts/audit-frontend.mjs",
    "test:frontend": "tsx --test scripts/frontend-smoke.test.ts",
    "test:customers": "tsx --test scripts/customer-hub.test.ts",
    "test:import": "tsx --test scripts/data-import.test.ts",
    "test:ai": "tsx --test scripts/ai-assistant.test.ts",
    "test:loyalty-reconcile": "tsx --test scripts/reconcile-loyalty.test.ts",
    "test:mall-backend": "tsx --test scripts/mall-backend.test.ts scripts/mall-safety.test.ts",
    "test:mall-part-payment": "tsx --test scripts/mall-part-payment.test.ts",
    "test:mall-money": "tsx --test scripts/mall-order-money.test.ts",
    "test:pos-ledger": "tsx --test scripts/pos-ledger.test.ts",
    "test:relational-money": "tsx --test scripts/relational-money-roundtrip.test.ts",
    "test:access": "tsx --test scripts/access-jwt.test.ts scripts/staff-access.test.ts scripts/staff-privileges.test.ts scripts/staff-accounts.test.ts",
    "test:auth-matrix": "tsx --test scripts/auth-route-matrix.test.ts",
    "test:money": "tsx --test scripts/money-*.test.ts",
    "test:regression": "tsx --test scripts/regression/*.test.ts",
    "coverage": "c8 --all --include=src/server/** --include=src/context/** --reporter=text --reporter=lcov --report-dir=coverage npm run test:money",
    "test:vocabulary": "tsx --test scripts/vocabulary-contract.test.ts",
    "test:money-math": "tsx --test scripts/money-math.property.test.ts",
    "test:money-flow": "tsx --test scripts/money-flow.integration.test.ts",
    "test:ci": "npm run lint && npm run test:vocabulary && npm run test:mall-backend && npm run test:access && npm run test:frontend && npm run test:money && npm run test:regression",
    "verify:access-apps": "tsx scripts/verify-access-apps.ts",
    "verify:access-aud": "tsx scripts/verify-access-aud.ts",
    "verify:email-dns": "tsx scripts/verify-email-dns.ts",
    "verify:frontend": "npm run lint && npm run audit:frontend && npm run test:frontend",
    "verify:mall": "npm run lint && npm run test:mall-backend",
    "verify:mall-preview": "tsx scripts/mall-preview-check.ts",
    "verify:mall-contract": "tsx scripts/verify-mall-contract.ts",
    "demo:mall-cascade": "tsx scripts/mall-cascade-demo.ts",
    "mail:test": "tsx scripts/send-mall-test-emails.ts",
    "ddl:gen": "tsx scripts/etl/gen-ddl.ts",
    "etl:dump": "tsx scripts/etl/dump.ts",
    "etl:run": "tsx scripts/etl/run.ts",
    "etl:inspect-clearance": "tsx scripts/etl/inspect-clearance.ts",
    "etl:verify-canon": "tsx scripts/etl/verify-canon-import.ts",
    "etl:reconcile-loyalty": "tsx scripts/etl/reconcile-loyalty.ts",
    "etl:report-customer-integrity": "tsx scripts/report-customer-integrity.ts",
    "etl:export-d1": "tsx scripts/etl/export-d1.ts",
    "canon:wipe": "tsx scripts/etl/wipe-target.ts",
    "canon:move": "tsx scripts/etl/move-canon.ts",
    "verify:relational": "tsx scripts/verify-relational.ts",
    "verify:writes": "tsx scripts/verify-relational-writes.ts",
    "verify": "tsx scripts/verify-relational.ts && tsx scripts/verify-relational-writes.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "c8": "^10.1.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "fast-check": "^4.10.2",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  }
}